# Скопируйте этот файл в .env.local и заполните значения.
# .env.local в git не попадает — это правильно, там секреты.
#
# На Vercel те же переменные задаются в
# Settings → Environment Variables.

# Токен Telegram-бота, который присылает заявки с формы записи.
# Получить: @BotFather → /newbot
# Это пароль от бота — не коммитить и не пересылать в открытых чатах.
TELEGRAM_BOT_TOKEN=

# ID чата, куда бот шлёт заявки.
# Свой ID: @userinfobot. ID группы начинается с минуса.
# Важно: сначала напишите боту любое сообщение, иначе он не сможет ответить.
TELEGRAM_CHAT_ID=

# Адрес сайта — используется в sitemap.xml, robots.txt и превью ссылок.
# Без него подставится http://localhost:3000. На проде задать обязательно.
NEXT_PUBLIC_SITE_URL=https://example.com
